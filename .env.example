# Copy to .env.local and fill in. Placeholders only; never commit real keys.
# Anything here is compiled into the browser bundle at build time (see README, Security notes).

# Gemini key (video generation, radio voice, photo verification)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional alternative read by Stage 03 and the vision helper
VITE_GOOGLE_AI_KEY=
# Google Maps JavaScript API key (world map screen)
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key-here
